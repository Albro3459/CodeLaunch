# Copy to .env and fill in. .env is gitignored; keep the real values out of git.
#   cp .env.example .env

# Public hostname served through the Cloudflare tunnel.
T3_HOSTNAME=code.example.com

# Local T3 backend. Loopback only — never bind this to 0.0.0.0.
T3_PORT=3773

# npm dist-tag for the t3 CLI and the headless backend: latest | nightly.
#
# This MUST match the channel of the T3 Code desktop app you installed. Both
# share the ~/.t3 store and the CLI runs schema migrations against it, so a
# mismatch can migrate the store to a schema the other side cannot read.
# start.sh and t3-pair.sh both enforce this and refuse to run on a mismatch
# (they read the app's version string, so a renamed .app is still detected).
#
# latest  -> stable cask, `T3 Code.app`            <- default, use this
# nightly -> nightly cask, `T3 Code (Nightly).app`
T3_CHANNEL=latest

# Named tunnel.
TUNNEL_NAME=t3-code

# Exact address allowed by the Access policy. No wildcards, no groups.
ACCESS_EMAIL=you@example.com

# Cloudflare Zero Trust team domain: <team>.cloudflareaccess.com
CLOUDFLARE_TEAM=your-team
